{
    "name": "selveq/persisted-query",
    "description": "Magento 2 Persisted Query extension for ScandiPWA theme",
    "type": "magento2-module",
    "version": "4.0.3",
    "license": [
        "OSL-3.0"
    ],
    "authors": [
        {
            "name": "Scandiweb",
            "homepage": "https://scandiweb.com",
            "role": "Original author"
        },
        {
            "name": "Selveq",
            "homepage": "https://selveq.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/selveq/persisted-query/issues",
        "source": "https://github.com/selveq/persisted-query"
    },
    "require": {
        "php": "^8.3",
        "magento/framework": "^103.0",
        "magento/module-cache-invalidate": "^100.4",
        "magento/module-page-cache": "^100.4",
        "magento/module-store": "^101.1",
        "magento/module-graph-ql": "^100.4",
        "magento/module-graph-ql-cache": "^100.4",
        "magento/module-catalog": "^104.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "colinmollenhour/credis": "^1.10"
    },
    "suggest": {
        "ext-redis": "Faster serialization of the registered queries through phpredis"
    },
    "replace": {
        "scandipwa/persisted-query": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "ScandiPWA\\PersistedQuery\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.gitignore"
        ]
    }
}
