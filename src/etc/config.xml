<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <scandipwa_persisted_query>
            <cache>
                <default_ttl>60</default_ttl>
                <max_ttl>2592000</max_ttl>
            </cache>
            <registration>
                <verify_hash>1</verify_hash>
            </registration>
        </scandipwa_persisted_query>
    </default>
</config>
