<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="scandipwa_persisted_query"
            translate="label"
            type="text"
            sortOrder="500"
            showInDefault="1"
            showInWebsite="1"
            showInStore="1">
            <label>Persisted Query</label>
            <tab>service</tab>
            <resource>ScandiPWA_PersistedQuery::config</resource>
            <group id="cache"
                translate="label"
                type="text"
                sortOrder="10"
                showInDefault="1"
                showInWebsite="1"
                showInStore="1">
                <label>Cache</label>
                <field id="default_ttl"
                    translate="label comment"
                    type="text"
                    sortOrder="10"
                    showInDefault="1"
                    showInWebsite="1"
                    showInStore="1"
                    canRestore="1">
                    <label>Default Query Cache TTL (seconds)</label>
                    <comment>Cache-Control max-age for a persisted query that carries no SW-cache-age.</comment>
                    <validate>validate-zero-or-greater validate-digits</validate>
                </field>
                <field id="max_ttl"
                    translate="label comment"
                    type="text"
                    sortOrder="20"
                    showInDefault="1"
                    showInWebsite="1"
                    showInStore="1"
                    canRestore="1">
                    <label>Maximum Query Cache TTL (seconds)</label>
                    <comment>Ceiling for the SW-cache-age a client may ask for, bounding how long a shared cache keeps a response. Values above 2592000 (the 30-day registration lifetime) are clamped.</comment>
                    <validate>validate-zero-or-greater validate-digits</validate>
                </field>
            </group>
            <group id="registration"
                translate="label"
                type="text"
                sortOrder="20"
                showInDefault="1"
                showInWebsite="1"
                showInStore="1">
                <label>Registration</label>
                <field id="verify_hash"
                    translate="label comment"
                    type="select"
                    sortOrder="10"
                    showInDefault="1"
                    showInWebsite="1"
                    showInStore="1"
                    canRestore="1">
                    <label>Verify Query Hash</label>
                    <comment>Reject a registration whose hash is not the one the ScandiPWA theme computes for the query.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
