<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\GraphQl\Controller\GraphQl">
        <plugin name="scandipwa_persisted_query"
            type="ScandiPWA\PersistedQuery\Plugin\PersistedQuery" />
    </type>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="scandipwa_pq_flush" xsi:type="object">
                    ScandiPWA\PersistedQuery\Console\Command\PersistedQueryFlushCommand
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\App\Cache\Type\FrontendPool">
        <arguments>
            <argument name="typeFrontendMap" xsi:type="array">
                <item name="persisted_query_response" xsi:type="string">page_cache</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Model\Indexer\Category\Product\Action\Full">
        <plugin name="invalidate_pq_response_cache"
            type="ScandiPWA\PersistedQuery\Plugin\InvalidatePQCache" />
    </type>

    <!-- optional constructor arguments are not auto-resolved by the ObjectManager, so the parser this class shares with core has to be named explicitly -->
    <type name="ScandiPWA\PersistedQuery\Query\QueryProcessor">
        <arguments>
            <argument name="queryParser" xsi:type="object">Magento\Framework\GraphQl\Query\QueryParser</argument>
        </arguments>
    </type>

    <type name="ScandiPWA\PersistedQuery\Console\Command\PersistedQueryFlushCommand">
        <arguments>
            <argument name="query" xsi:type="object">ScandiPWA\PersistedQuery\Cache\Query\Proxy</argument>
        </arguments>
    </type>
</config>
